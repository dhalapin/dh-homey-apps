{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.hotwater.aosmith",
  "version": "1.0.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "brandColor": "#007934",
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "A. O. Smith"
  },
  "description": {
    "en": "Monitor and control A. O. Smith iCOMM water heaters."
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/AOS-small.png",
    "large": "/assets/images/AOS-large.png"
  },
  "author": {
    "name": "Daniel Halapin",
    "email": "danielhalapin6@gmail.com"
  },
  "drivers": [
    {
      "name": {
        "en": "Water Heater"
      },
      "class": "waterheater",
      "images": {
        "small": "/drivers/water-heater/assets/images/AOS-WH-small.jpg",
        "large": "/drivers/water-heater/assets/images/AOS-WH-large.jpg",
        "xlarge": "/drivers/water-heater/assets/images/AOS-WH-xlarge.jpg"
      },
      "capabilities": [
        "target_temperature",
        "aosmith_mode",
        "measure_hot_water",
        "meter_power"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 35,
          "max": 60,
          "step": 0.5
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "/drivers/water-heater/assets/iCOMM.png",
            "title": {
              "en": "iCOMM Credentials"
            },
            "usernameLabel": {
              "en": "E-mail address"
            },
            "usernamePlaceholder": {
              "en": "john@doe.com"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": "Password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "water-heater"
    }
  ],
  "capabilities": {
    "aosmith_hot_water_plus": {
      "type": "enum",
      "title": {
        "en": "Hot Water+ level"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "off",
          "title": {
            "en": "Off"
          }
        },
        {
          "id": "level1",
          "title": {
            "en": "Level 1"
          }
        },
        {
          "id": "level2",
          "title": {
            "en": "Level 2"
          }
        },
        {
          "id": "level3",
          "title": {
            "en": "Level 3"
          }
        }
      ]
    },
    "aosmith_mode": {
      "type": "enum",
      "title": {
        "en": "Mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "eco",
          "title": {
            "en": "Eco (Hybrid)"
          }
        },
        {
          "id": "heat_pump",
          "title": {
            "en": "Heat pump"
          }
        },
        {
          "id": "electric",
          "title": {
            "en": "Electric"
          }
        },
        {
          "id": "vacation",
          "title": {
            "en": "Vacation / away"
          }
        },
        {
          "id": "guest",
          "title": {
            "en": "Guest"
          }
        }
      ]
    },
    "measure_hot_water": {
      "type": "number",
      "title": {
        "en": "Hot water availability"
      },
      "units": {
        "en": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  }
}